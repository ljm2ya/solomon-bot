# Solomon Bot Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Slack Bot Token
# Get from: Your Slack App > OAuth & Permissions > Bot User OAuth Token
BOT_TOKEN=xoxb-your-bot-token-here

# Slack App Token (for Socket Mode)
# Get from: Your Slack App > Basic Information > App-Level Tokens
APP_TOKEN=xapp-your-app-level-token-here

# Optional: Debug mode (uncomment to enable detailed logging)
# DEBUG=true